<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>NetDoctorSelfTest</AssemblyName>
    <RootNamespace>NetDoctorTest</RootNamespace>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <NoWarn>CA1416;WFO1000;WFO0003</NoWarn>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\src\Core\*.cs" LinkBase="Core" />
    <EmbeddedResource Include="..\src\Core\nettop.ps1" LogicalName="NetDoctor.Data.nettop.ps1" />
    <EmbeddedResource Include="..\src\Core\sysitems.ps1" LogicalName="NetDoctor.Data.sysitems.ps1" />
    <Compile Include="..\src\Theme.cs" LinkBase="UI" />
    <Compile Include="..\src\UI\CheckList.cs" LinkBase="UI" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.ServiceProcess.ServiceController" Version="9.0.0" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\src\Data\Optimizations.xml" LogicalName="NetDoctor.Data.Optimizations.xml" />
  </ItemGroup>

</Project>
