<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>夕颜若雪网络工具</AssemblyName>
    <RootNamespace>NetDoctor</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>1.3.0</Version>
    <Product>夕颜若雪网络工具</Product>
    <FileVersion>1.3.0.0</FileVersion>
    <AssemblyVersion>1.3.0.0</AssemblyVersion>
    <Company>xiyanruoxue</Company>
    <Copyright>网络检测 / 断网修复 / 网络优化</Copyright>
    <SatelliteResourceLanguages>zh-Hans</SatelliteResourceLanguages>
    <DebugType>none</DebugType>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ApplicationHighDpiMode>DpiUnaware</ApplicationHighDpiMode>
    <NoWarn>CA1416;WFO5001;WFO1000;WFO0003</NoWarn>
    <InvariantGlobalization>false</InvariantGlobalization>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <WarningsNotAsErrors>WFO1000;WFO0003</WarningsNotAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <!-- 内置 Windows 优化配置（源自 ZyperWin++ 的声明式配置，编译进 exe，运行时零外部依赖） -->
    <EmbeddedResource Include="Data\Optimizations.xml" LogicalName="NetDoctor.Data.Optimizations.xml" />
  </ItemGroup>

  <ItemGroup>
    <!-- PowerShell 脚本编译进 exe，运行时释放到 .runtime 目录（见 EmbeddedScripts） -->
    <EmbeddedResource Include="Core\nettop.ps1" LogicalName="NetDoctor.Data.nettop.ps1" />
    <EmbeddedResource Include="Core\sysitems.ps1" LogicalName="NetDoctor.Data.sysitems.ps1" />
  </ItemGroup>

  <ItemGroup>
    <!-- 自测工程与本工程使用同一批源文件，不能同时被编译进来 -->
    <Compile Remove="selftest\**" />
    <None Remove="selftest\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.ServiceProcess.ServiceController" Version="9.0.0" />
  </ItemGroup>

</Project>
