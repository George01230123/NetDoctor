<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>夕颜若雪网络工具</AssemblyName>
    <RootNamespace>NetDoctor</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>1.4.2</Version>
    <Product>夕颜若雪网络工具</Product>
    <FileVersion>1.4.2.0</FileVersion>
    <AssemblyVersion>1.4.2.0</AssemblyVersion>
    <Company>George01230123</Company>
    <Copyright>网络检测 / 断网修复 / 网络优化 / Windows优化 / 系统工具 / 硬件检测</Copyright>
    <Description>一体化 Windows 系统工具：网络诊断修复、Windows 优化、垃圾清理、应用/服务/启动项管理、硬件检测与跑分</Description>
    <SatelliteResourceLanguages>zh-Hans</SatelliteResourceLanguages>
    <DebugType>none</DebugType>
    <!-- 不要 SourceLink 生成的 +sha 版本后缀，保持发布版本号干净 -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ApplicationHighDpiMode>DpiUnaware</ApplicationHighDpiMode>
    <NoWarn>CA1416;WFO5001;WFO1000;WFO0003</NoWarn>
    <InvariantGlobalization>false</InvariantGlobalization>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <WarningsNotAsErrors>WFO1000;WFO0003</WarningsNotAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <!-- 内置 Windows 优化定义：本项目自建格式，编译进 exe，运行时零外部依赖 -->
    <EmbeddedResource Include="Data\Optimizations.xml" LogicalName="NetDoctor.Data.Optimizations.xml" />
  </ItemGroup>

  <ItemGroup>
    <!-- PowerShell 脚本编译进 exe，运行时释放到 .runtime 目录（见 EmbeddedScripts） -->
    <EmbeddedResource Include="Core\nettop.ps1" LogicalName="NetDoctor.Data.nettop.ps1" />
    <EmbeddedResource Include="Core\sysitems.ps1" LogicalName="NetDoctor.Data.sysitems.ps1" />
  </ItemGroup>

  <ItemGroup>
    <!-- 自测工程与原生 DLL 工程各自有入口/导出文件，不能一起编译进来 -->
    <Compile Remove="selftest\**" />
    <None Remove="selftest\**" />
    <Compile Remove="native\**" />
    <None Remove="native\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.ServiceProcess.ServiceController" Version="9.0.0" />
  </ItemGroup>

</Project>
