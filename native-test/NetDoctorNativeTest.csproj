<Project Sdk="Microsoft.NET.Sdk">

  <!--
    原生 DLL 的 x86 测试宿主。
    发布为 x86 NativeAOT 原生 exe，用 LoadLibrary + GetProcAddress + 委托
    完全模拟易语言的调用方式，无需安装易语言即可验证 DLL 是否可用。
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>NetDoctorNativeTest</AssemblyName>
    <RootNamespace>NetDoctor.NativeTest</RootNamespace>

    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
    <StackTraceSupport>false</StackTraceSupport>
    <DebugType>none</DebugType>
    <NoWarn>CA1416</NoWarn>

    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Program.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- 被测 DLL 与依赖脚本一起放到输出目录，便于直接运行 -->
    <None Include="..\native\bin\Release\net10.0\win-x86\publish\NetDoctorNative.dll"
          Link="NetDoctorNative.dll"
          CopyToOutputDirectory="PreserveNewest"
          Condition="Exists('..\native\bin\Release\net10.0\win-x86\publish\NetDoctorNative.dll')" />
  </ItemGroup>

</Project>
